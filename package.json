{
  "name": "angular",
  "version": "0.16.0",
  "scripts": {
    "ng": "ng",
    "prepare": "husky",
    "start": "yarn api:generate && node ./node_modules/@angular/cli/bin/ng serve",
    "start:dev": "yarn api:generate && node ./node_modules/@angular/cli/bin/ng serve --configuration=dev --proxy-config proxy.conf.json",
    "start:test": "yarn api:generate && node ./node_modules/@angular/cli/bin/ng serve --configuration=test",
    "start:prod": "yarn api:generate && node ./node_modules/@angular/cli/bin/ng serve --configuration=production",
    "start:mock": "yarn api:generate && node ./node_modules/@angular/cli/bin/ng serve --configuration=mock --proxy-config proxy.conf.json",
    "build": "yarn api:generate && node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build",
    "build-release": "yarn api:generate && node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build --configuration=production --output-path=dist/release",
    "build-test": "yarn api:generate && node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build --configuration=test --output-path=dist/test",
    "test": "yarn api:generate && ng test --coverage",
    "testp": "yarn api:generate && ng test  --coverage --test-path-patterns",
    "test:ci": "yarn api:generate && ng test --ci --reporters=jest-junit --coverage --watch=false",
    "test:watch": "yarn api:generate && ng test --coverage --watch",
    "test:leak-check": "yarn api:generate && node tools/test-leak-analyzer.js",
    "lint": "ng lint --fix && prettier --write \"src/**/*.scss\"",
    "lint:ci": "ng lint && prettier --check \"src/**/*.scss\"",
    "lint-staged": "yarn lint-staged --relative",
    "e2e": "yarn api:generate && ng e2e",
    "api:generate": "yarn openapi-generator-cli generate",
    "translations": "node tools/translations.js",
    "update-cmake": "node tools/update-cmake.js",
    "check:dev": "yarn api:generate && yarn translations && yarn update-cmake && yarn lint && yarn test && yarn build-release && yarn build-test"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "yarn lint"
    ]
  },
  "packageManager": "yarn@4.10.3",
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@angular/animations": "21.2.23",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/material": "21.2.9",
    "@angular/platform-browser": "21.2.23",
    "@angular/platform-browser-dynamic": "21.2.23",
    "@angular/router": "21.2.23",
    "@ng-matero/extensions": "^21.3.0",
    "@ngneat/input-mask": "^6.1.0",
    "@tps/angular-translation": "^1.1.0",
    "@ungap/structured-clone": "^1.3.1",
    "angular-oauth2-oidc": "^20.0.2",
    "angular-split": "^20.0.0",
    "dayjs": "^1.11.18",
    "duration": "^0.2.2",
    "inputmask": "^5.0.9",
    "ngx-csv-parser": "^2.0.0",
    "ngx-mask": "^21.0.1",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "utf8": "^3.0.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular-devkit/build-angular": "21.2.23",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "@angular/language-service": "21.2.23",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/inputmask": "^5.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/ungap__structured-clone": "^1.2.0",
    "@types/utf8": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@typescript-eslint/types": "^8.46.2",
    "@typescript-eslint/utils": "^8.46.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.1.5",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "jest-marbles": "^3.1.1",
    "jest-preset-angular": "^16.1.4",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
